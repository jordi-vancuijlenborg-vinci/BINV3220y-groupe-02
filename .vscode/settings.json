{
     // Les nouvelles sessions dÃ©marrent en permissions manuelles.
  // Ne pas activer Allow all, Autopilot ou l'auto-approbation globale.
  "chat.permissions.default": "default",
  "chat.tools.global.autoApprove": false,

  // Active l'approbation sÃ©lective des commandes. Les rÃ¨gles de sÃ©curitÃ©
  // intÃ©grÃ©es de VS Code restent actives.
  "chat.tools.terminal.enableAutoApprove": true,
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
  "chat.tools.terminal.blockDetectedFileWrites": "outsideWorkspace",

  "chat.tools.terminal.autoApprove": {
    // Exploration locale en lecture seule.
    "pwd": true,
    "ls": true,
    "rg": true,
    "grep": true,
    "head": true,
    "tail": true,
    "wc": true,
    "cat": true,

    // Consultation de Git sans modification du dÃ©pÃ´t.
    "/^git (status|diff|log|show|rev-parse|ls-files)(\\s|$)/": true,

    // ContrÃ´les locaux prÃ©vus par le projet Gesta.
    "/^npm (test|run (lint|typecheck|test|build|check|setup|dev))(\\s|$)/": true,

    // Ces commandes restent possibles, mais exigent une dÃ©cision explicite.
    "/^npm (ci|install|uninstall|update)(\\s|$)/": false,
    "/^npx(\\s|$)/": false,
    "/^node(\\s|$)/": false,
    "/^(curl|wget)(\\s|$)/": false,
    "/^gh(\\s|$)/": false,
    "/^git (add|commit|push|pull|fetch|checkout|switch|restore|reset|clean|merge|rebase|cherry-pick|revert|stash|tag|branch)(\\s|$)/": false,
    "/^(rm|rmdir|del|sudo|chmod|chown|kill)(\\s|$)/": false,
    "/^Remove-Item\\b/i": false
  },

  // Les modifications ordinaires dans le workspace sont autorisÃ©es.
  // Les fichiers sensibles restent soumis Ã  approbation.
  "chat.tools.edits.autoApprove": {
    "**/*": true,
    "**/.env": false,
    "**/.env.*": false,
    "**/.git/**": false,
    "**/.vscode/*.json": false,
    "**/package-lock.json": false
  },

  // La sandbox accorde automatiquement la lecture et l'Ã©criture dans le
  // rÃ©pertoire de travail. Aucun chemin extÃ©rieur supplÃ©mentaire n'est ajoutÃ©.
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.fileSystem.userConfiguredPaths": {
    "readwritePaths": [],
    "readonlyPaths": [],
    "deniedPaths": []
  },

  // NÃ©cessaire pour lancer Node, npm, TypeScript et les tests installÃ©s.
  "chat.agent.sandbox.fileSystem.allowDevToolAccess": true,

  // Le rÃ©seau externe est bloquÃ©. Le rÃ©seau local reste disponible pour
  // l'application sur localhost:3000 et localhost:5173.
  "chat.agent.sandbox.network.allowNetwork": false,
  "chat.agent.sandbox.network.allowLocalNetwork": true,

  // Une commande incompatible avec la sandbox est proposÃ©e Ã  l'acceptation
  "chat.agent.sandbox.allowUnsandboxedCommands": true,

  // Ne pas transmettre les identifiants Git ou GitHub aux processus sandboxÃ©s.
  "chat.agent.sandbox.credentials.authenticategit": false,
  "chat.agent.sandbox.credentials.authenticategh": false,

  // Les processus auxiliaires lancÃ©s par Copilot restent confinÃ©s.
  "chat.agent.sandbox.mcpServers": true,
  "chat.agent.sandbox.lspServers": true,

  // Bloque Ã©galement les outils Fetch et navigateur intÃ©grÃ©s.
  "chat.agent.networkFilter": true
}