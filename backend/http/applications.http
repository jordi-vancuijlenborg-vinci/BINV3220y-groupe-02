@baseUrl = http://localhost:3000
@token = replace-with-student-token

### Candidater à une offre publiée
POST {{baseUrl}}/offers/1/applications
Authorization: {{token}}
Content-Type: application/json

{
  "message": "Le sujet m'intéresse particulièrement."
}

### Consulter ses candidatures
GET {{baseUrl}}/applications
Authorization: {{token}}

### Retirer une candidature en cours
POST {{baseUrl}}/applications/1/withdraw
Authorization: {{token}}
